# Copy to .env.local (local) and add the same two variables in Vercel -> Settings -> Environment Variables.
# Both are server-only secrets. Never prefix them with NEXT_PUBLIC_ and never commit them.

# Neon -> your project -> Connect -> keep "Pooled connection" on -> copy the string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# A long random phrase of your choice. You type it once per device/browser when you press Sync.
SYNC_PASSCODE=change-me-to-a-long-random-phrase
